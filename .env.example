# Backend - MT5
CUSTOM_USER=admin
PASSWORD=1234
MT5_API_PORT=5001
MT5_API_KEY=your-secret-api-key-here

# CRT auto-trading bot
CRT_ENABLED=false
CRT_SYMBOLS=XAUUSD,EURUSD,GBPUSD,AUDUSD,USDCHF,NZDUSD,USDCAD
CRT_LOT=0.01
CRT_DEVIATION=20
CRT_MAGIC_BASE=770000
CRT_POLL_INTERVAL=5
CRT_MAX_SIGNAL_AGE=300
CRT_MIN_RR=1.0

# Commission — Flat ($/lot round-trip): applies to XAUUSD, XAGUSD, AUDUSD, forex pairs, etc.
CRT_COMMISSION_PER_LOT=5.0

# Commission — Percentage of notional: applies to BTCUSD and similar crypto/CFD
# Format: comma-separated symbol list
CRT_COMMISSION_PCT_SYMBOLS=BTCUSD
# Rate in % (e.g. 0.04 means 0.04 %). Round-trip.
CRT_COMMISSION_PCT_RATE=0.04

# Stop loss placement
# Extra SL room beyond the C2 wick, in multiples of the current spread (SELL always gets +1 spread)
CRT_SL_BUFFER_SPREADS=0
# Skip setups whose SL is closer than N x spread (0 disables)
CRT_MIN_SL_SPREADS=3
# Move SL to break-even (entry + commission) at this fraction of the entry->TP distance
CRT_BE_TRIGGER=0.47

# 2-candle CRT bot (candle_two_bot.py) — runs alongside the CRT bot
CRT2_ENABLED=false
CRT2_SYMBOLS=XAUUSD,EURUSD,GBPUSD,AUDUSD,USDCHF,NZDUSD,USDCAD
CRT2_LOT=0.01
CRT2_DEVIATION=20
CRT2_MAGIC_BASE=780000
CRT2_POLL_INTERVAL=2
CRT2_MIN_RR=0
CRT2_SL_BUFFER_SPREADS=0
CRT2_MIN_SL_SPREADS=3
# Break-even triggers this far into C1's range, measured from the swept side
CRT2_BE_TRIGGER=0.45

# Trade journal (SQLite) — written by the bots, read by the dashboard
# Files: <BOT_DB_DIR>/bots.db (live) and <BOT_DB_DIR>/dashboard.db (snapshot)
BOT_DB_DIR=/config/data
BOT_DB_SYNC_SECONDS=30
BOT_DB_BACKFILL_DAYS=90
# Snapshot rewrites caused only by new signals/skips: at most this often (seconds)
BOT_DB_EVENT_SNAPSHOT_SECONDS=300
# Days of daily signal/skip counts before they are merged into weekly totals
BOT_DB_DAILY_COUNT_DAYS=30

# Dashboard login (http://your-server:8080) — required, the dashboard won't start without it
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Daily sweep bot (daily_sweep_bot.py) — CRT on the daily candle, against the daily trend
DSW_ENABLED=false
DSW_SYMBOLS=XAUUSD,EURUSD,GBPUSD,AUDUSD,USDCHF,NZDUSD,USDCAD
DSW_LOT=0.01
DSW_MAGIC_BASE=790000
DSW_TREND=against
DSW_SMA_DAYS=20
DSW_TP_FRAC=1.0
DSW_MIN_SL_SPREADS=3
DSW_SL_BUFFER_SPREADS=0
DSW_BE_TRIGGER=0

# Indicator bots (indicator_bots.py) — 10 popular strategies, each its own bot
# Turn all on for demo testing, or set IND_<KEY>_ENABLED per bot
# Keys: EMA2050 EMA921 GOLDEN MACD RSI BBANDS SUPERTREND DONCHIAN STOCH ICHIMOKU
IND_ALL_ENABLED=false
# Examples of per-bot settings (defaults shown):
# IND_EMA2050_ENABLED=true
# IND_EMA2050_SYMBOLS=EURUSD,GBPUSD
# IND_EMA2050_TFS=H4,H1,M30,M15
# IND_EMA2050_LOT=0.01
# IND_EMA2050_SL_ATR=1.5
# IND_EMA2050_RR=2.0
