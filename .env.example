# Backend - MT5
CUSTOM_USER=admin
PASSWORD=1234
MT5_API_PORT=5001
MT5_API_KEY=your-secret-api-key-here

# CRT auto-trading bot
CRT_ENABLED=false
CRT_SYMBOLS=XAUUSD,EURUSD,GBPUSD,AUDUSD,USDCHF,NZDUSD,USDCAD
CRT_LOT=0.01
CRT_DEVIATION=20
CRT_MAGIC_BASE=770000
CRT_POLL_INTERVAL=5
CRT_MAX_SIGNAL_AGE=300
CRT_MIN_RR=1.0

# Commission — Flat ($/lot round-trip): applies to XAUUSD, XAGUSD, AUDUSD, forex pairs, etc.
CRT_COMMISSION_PER_LOT=5.0

# Commission — Percentage of notional: applies to BTCUSD and similar crypto/CFD
# Format: comma-separated symbol list
CRT_COMMISSION_PCT_SYMBOLS=BTCUSD
# Rate in % (e.g. 0.04 means 0.04 %). Round-trip.
CRT_COMMISSION_PCT_RATE=0.04

# Stop loss placement
# Extra SL room beyond the C2 wick, in multiples of the current spread (SELL always gets +1 spread)
CRT_SL_BUFFER_SPREADS=0
# Skip setups whose SL is closer than N x spread (0 disables)
CRT_MIN_SL_SPREADS=3
# Move SL to break-even (entry + commission) at this fraction of the entry->TP distance
CRT_BE_TRIGGER=0.47
# At break-even, close this % of the position (0 = off); optional trailing SL in R after BE
CRT_PARTIAL_PCT=50
CRT_TRAIL_R=0

# 2-candle CRT bot (candle_two_bot.py) — runs alongside the CRT bot
CRT2_ENABLED=false
CRT2_SYMBOLS=XAUUSD,EURUSD,GBPUSD,AUDUSD,USDCHF,NZDUSD,USDCAD
CRT2_LOT=0.01
CRT2_DEVIATION=20
CRT2_MAGIC_BASE=780000
CRT2_POLL_INTERVAL=2
CRT2_MIN_RR=0
CRT2_SL_BUFFER_SPREADS=0
CRT2_MIN_SL_SPREADS=3
# Break-even triggers this far into C1's range, measured from the swept side
CRT2_BE_TRIGGER=0.45
CRT2_PARTIAL_PCT=50
CRT2_TRAIL_R=0

# Trade journal (SQLite) — written by the bots, read by the dashboard
# Files: <BOT_DB_DIR>/bots.db (live) and <BOT_DB_DIR>/dashboard.db (snapshot)
BOT_DB_DIR=/config/data
BOT_DB_SYNC_SECONDS=30
BOT_DB_BACKFILL_DAYS=90
# Snapshot rewrites caused only by new signals/skips: at most this often (seconds)
BOT_DB_EVENT_SNAPSHOT_SECONDS=300
# Days of daily signal/skip counts before they are merged into weekly totals
BOT_DB_DAILY_COUNT_DAYS=30

# Dashboard login (http://your-server:8080) — required, the dashboard won't start without it
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# Public HTTPS address of the dashboard (Caddy). Point its DNS A record at this server
# and open ports 80 + 443; the certificate is issued automatically on first start.
DASHBOARD_DOMAIN=bots.mrejp.tech

# Bots need a HEDGING account (several bots per symbol). They refuse to trade on netting
# unless this is true — only sensible with one bot per symbol.
BOTS_ALLOW_NETTING=false

# Position size for every bot: each trade loses this % of the balance if its SL is hit.
# 0 = use each bot's fixed *_LOT setting instead. The dashboard's "Account limits" card
# overrides these two once you save it there.
BOTS_RISK_PCT=0.5
# The broker's minimum lot may risk up to this × the target; above that the trade is skipped
BOTS_RISK_MAX_OVER=1.5

# Folder of the dashboard's Start/Stop files (one per bot). Must match the dashboard's
# ./config/control mount in docker-compose.yml.
# BOTS_CONTROL_DIR=/config/control

# Account limits for all bots together (prop-firm style); 0 = off. The dashboard's
# "Account limits" card overrides these once you save it there.
#   daily loss: closed today + floating of open bot trades; when hit, all bot trades are
#   closed and no new ones open until the next broker day.
BOTS_MAX_DAILY_LOSS=0
BOTS_MAX_OPEN_TRADES=0

# Telegram alerts: every rejected order, failed close / SL move and bot error is sent to this chat (off when empty).
# Send /start to your bot, then find the chat id at https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Statuses that alert, and minutes before the same problem is sent again
TELEGRAM_STATUSES=rejected,failed,error
TELEGRAM_REPEAT_MINUTES=30
# Send "bots started" on every app start, to check the token / chat id
TELEGRAM_STARTUP_MESSAGE=true

# CRT + trend filter bots (crt_trend_bots.py) — separate bots next to crt3 / crt2.
# Same rules as the originals (every CRT3T_/CRT2T_ setting defaults to the CRT_/CRT2_ one),
# but only in the direction of the next higher TF: M15→H1, M30→H4, H1→H4, H4→D1.
CRT3T_ENABLED=false
CRT2T_ENABLED=false
# CRT3T_MAGIC_BASE=830000
# CRT2T_MAGIC_BASE=840000
# Trend = higher-TF close above a rising EMA (BUY only) / below a falling one (SELL only)
# CRT3T_TREND_EMA=50
# CRT3T_TREND_SLOPE_BARS=5

# Strict 3-candle CRT (crt3_strict_bot.py) — separate bot next to crt3, settings default to CRT_*.
# Strong C1 (wicks ≤ 30% of range); C2 sweeps, closes back inside and stays within 40% of C1
# from the swept side; enter at C3 open. TP C1's other side; at C1's 50% half closed + BE.
CRT3S_ENABLED=false
# CRT3S_MAGIC_BASE=860000
# CRT3S_C1_MAX_WICK=0.30
# CRT3S_C2_MAX_RETRACE=0.40
# CRT3S_BE_LEVEL=0.50

# Candle 2 — TTrades fractal model (candle2_fractal_bot.py): D1/H4 candle sweeps the previous
# high/low, CISD on the entry TF, TP by wick size (small → C1's other side, large → C2's open)
C2F_ENABLED=false
# C2F_TFS=D1,H4
# C2F_ENTRY_D1=M15
# C2F_ENTRY_H4=M5
# C2F_WICK_SMALL=0.5
# C2F_MAGIC_BASE=850000
# C2F_BE_TRIGGER=0.5
# C2F_PARTIAL_PCT=50

# EJPC3 — CRT + CISD multi-timeframe (ejpc3_bot.py): HTF CRT with a C2 CISD, enter on the C3 CISD.
# Pairs (entry→HTF): M1→M15, M5→H1, M15→H4, H1→D1, H4→W1. SL beyond the C3 CISD swing,
# TP at STD -2, half closed + BE at 50% of the way. Size: BOTS_RISK_PCT. Majors only, no gold.
EJPC3_ENABLED=false
# EJPC3_SYMBOLS=EURUSD,GBPUSD,AUDUSD,USDCHF,NZDUSD,USDCAD
# EJPC3_TFS=W1,D1,H4,H1,M15
# EJPC3_STD_MULT=2
# EJPC3_MAGIC_BASE=870000
# EJPC3_BE_TRIGGER=0.5
# EJPC3_PARTIAL_PCT=50
